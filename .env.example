# NextRound Monorepo Environment Variables

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextround?schema=public

# Redis (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# Auth & Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-change-in-production
INTERNAL_SERVICE_SECRET=super-secret-internal-service-key-for-ai-callbacks

# AI Service Keys
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Storage (Local Filesystem)
UPLOAD_DIR=uploads

# Social Profile Scraper (LinkedIn sync — ai-service sourcing parity)
LINKEDIN_SCRAPER_BASE_URL=https://social_scraper.bytemap.in
LINKEDIN_SCRAPER_TIMEOUT_MS=90000

# WebRTC ICE servers for interview sessions (JSON array of { urls, username?, credential? }).
# Leave unset for the public Google STUN dev default. Provide TURN credentials only if you
# have real ones — no TURN is invented when this is absent.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# Email Transporter (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM="NextRound Hiring Platform <noreply@nextround.ai>"

# Public App URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPRESS_API_BASE_URL=http://localhost:4000/api/v1
