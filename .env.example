# Server Configuration
PORT=4000
NODE_ENV=development

# AI Service Configuration
AI_PORT=8000
AI_HOST=0.0.0.0
AI_ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:123456789@localhost:7003/postgres
DIRECT_URL=postgresql://postgres:123456789@localhost:7003/postgres

# Redis
REDIS_URL=http://localhost:6379/
LOCAL_REDIS_URL=http://localhost:6379/

# Auth Secrets
JWT_SECRET=your-jwt-access-secret-at-least-16-chars
REFRESH_TOKEN_SECRET=your-jwt-refresh-secret-at-least-16-chars
INTERNAL_SERVICE_SECRET=your-ai-callback-secret-at-least-16-chars

# Service URLs
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_AI_BASE_URL=http://localhost:8000
AI_BASE_URL=http://localhost:8000

# Storage
UPLOAD_DIR=uploads
AWS_ENDPOINT_URL=http://192.168.31.239:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=nextroundbucket

# WebRTC & Scraper
WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]
PROFILE_SCRAPER_BASE_URL=http://127.0.0.1:18273
PROFILE_SCRAPER_TIMEOUT_MS=90000

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=noreply@nextround.ai

# LLM Providers
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
