# =============================================================================
# NextRound / HireOS - Environment Configuration
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# Next.js Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_AI_BASE_URL=http://localhost:8000

# Authentication & Security Secrets
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_characters
REFRESH_TOKEN_SECRET=replace_with_a_secure_refresh_secret_at_least_32_characters
INTERNAL_SERVICE_SECRET=replace_with_internal_secret_for_ai_service_callbacks

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public

# In-Memory Queue & Caching (Redis 7/8)
REDIS_URL=redis://localhost:6379
LOCAL_REDIS_URL=redis://localhost:6379
REDIS_PROVIDER=local

# LocalStack S3 Storage
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=nextroundbucket

# AI Service (FastAPI + LangGraph)
AI_PORT=8000
AI_HOST=0.0.0.0
AI_ENVIRONMENT=development
AI_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# LLM Providers (gemini / groq / ollama)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Email Transport (SMTP / Mailtrap)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NextRound <noreply@nextround.ai>

# External Scrapers & Telemetry
PROFILE_SCRAPER_BASE_URL=http://127.0.0.1:18273
PROFILE_SCRAPER_TIMEOUT_MS=90000
