# NextRound AI Service environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# HTTP server
PORT=8000
HOST=0.0.0.0

# Environment: development | production. Production fails fast on default secrets.
ENVIRONMENT=development

# Shared secret with the Express API internal webhooks. MUST be a strong,
# unique value in production (match apps/api INTERNAL_SERVICE_SECRET).
INTERNAL_SERVICE_SECRET="internal_secret_key_change_in_production"

# Base URL of the Express API (internal callback webhooks live under /api/v1/internal)
EXPRESS_API_BASE_URL="http://localhost:4000/api/v1"

# Redis for queue/pub-sub
REDIS_URL="redis://localhost:6379"

# Provider API keys (never commit real values)
GEMINI_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# Model overrides (defaults live in core/config.py)
GEMINI_MODEL="gemini-2.5-flash"
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional local Ollama fallback
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Where uploaded interview/audio artifacts are written (defaults to apps/api/uploads)
UPLOAD_DIR="uploads"

# Where canonical shared data (aptitude + coding problem banks) lives.
# Defaults to ../../../packages/shared/data relative to this service; override
# only if the workspace layout differs (e.g. packaged containers).
# SHARED_DATA_DIR="packages/shared/data"
