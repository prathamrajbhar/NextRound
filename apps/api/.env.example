# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextround?schema=public

# Redis (BullMQ + Upstash REST client)
REDIS_URL=rediss://default:password@your-upstash-db.upstash.io:6379
UPSTASH_REDIS_REST_URL=https://your-upstash-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Auth secrets
JWT_SECRET=your-jwt-access-secret-at-least-16-chars
REFRESH_TOKEN_SECRET=your-jwt-refresh-secret-at-least-16-chars
INTERNAL_SERVICE_SECRET=your-ai-callback-secret-at-least-16-chars

# Service URLs
APP_URL=http://localhost:3000
AI_BASE_URL=http://localhost:8000

# Storage
UPLOAD_DIR=uploads
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="your-supabase-storage-bucket"

# WebRTC
WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# Profile scraper
PROFILE_SCRAPER_BASE_URL=https://social_scraper.bytemap.in
PROFILE_SCRAPER_TIMEOUT_MS=90000

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=noreply@nextround.ai

# LLM
GEMINI_API_KEY=your-gemini-api-key