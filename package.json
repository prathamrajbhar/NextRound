{
  "name": "nextround-monorepo",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others \"node --env-file=.env node_modules/turbo/bin/turbo dev\" \"node --env-file=.env scripts/run-ai-service.js\"",
    "build": "node --env-file=.env node_modules/turbo/bin/turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "db:generate": "npm run generate --workspace=@nextround/database",
    "db:migrate": "npm run migrate --workspace=@nextround/database",
    "db:studio": "npm run studio --workspace=@nextround/database"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.4",
    "turbo": "^2.10.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "prisma": {
    "schema": "packages/database/prisma/schema.prisma"
  }
}
