generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  hr
  candidate
}

enum JobStatus {
  draft
  published
  active
  paused
  closed
  deleted
}

enum ApplicationStatus {
  applied
  screening
  screening_completed
  assessment
  interview_scheduled
  interviewed
  evaluation
  hr_round
  decided
  offered
  accepted
  rejected
  withdrawn
}

enum HrRoundStatus {
  pending
  scheduled
  passed
  failed
}

enum EvaluationDecision {
  hire
  reject
  hold_for_review
}

enum InterviewStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum AssessmentType {
  aptitude
  coding
  video
}

enum AssessmentStatus {
  pending
  in_progress
  completed
  expired
}

enum OfferStatus {
  pending
  accepted
  declined
  expired
}

enum AgentStatus {
  running
  completed
  failed
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password_hash      String
  role               UserRole
  org_id             String?
  reset_token_hash   String?
  reset_token_expiry DateTime?
  // HR/recruiter profile details (name, avatar, timezone, linkedin, title, specialties)
  profile            Json      @default("{}")
  created_at         DateTime  @default(now())

  organization      Organization?     @relation(fields: [org_id], references: [id], onDelete: SetNull)
  candidate_profile CandidateProfile?
  notifications     Notification[]

  @@index([email])
  @@index([org_id])
  @@index([reset_token_hash])
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  logo_url   String?
  industry   String?
  size       String?
  settings   Json     @default("{}")
  created_at DateTime @default(now())

  users         User[]
  jobs          Job[]
  agent_logs    AgentLog[]
  prep_contents PrepContent[]
  talent_bookmarks TalentBookmark[]
}

model Job {
  id              String                    @id @default(uuid())
  org_id          String
  title           String
  description     String                    @db.Text
  rubric          Json                      @default("{}")
  thresholds      Json                      @default("{}")
  status          JobStatus                 @default(draft)
  location        String?
  salary          String?
  experienceLevel String?
  department      String?
  skills          Json?
  stages          Json?
  assessmentConfig Json?
  embedding       Unsupported("vector(768)")?
  created_at      DateTime                  @default(now())

  organization  Organization  @relation(fields: [org_id], references: [id], onDelete: Cascade)
  applications  Application[]
  agent_logs    AgentLog[]
  prep_contents PrepContent[]
  talent_bookmarks TalentBookmark[]

  @@index([org_id])
  @@index([status])
}

model CandidateProfile {
  id                 String                     @id @default(uuid())
  user_id            String                     @unique
  full_name          String?
  headline           String?
  phone              String?
  location           String?
  timezone           String?
  resume_url         String?
  raw_resume_text    String?                    @db.Text
  parsed_resume      Json                       @default("{}")
  social_data        Json                       @default("{}")
  linkedin_url       String?
  github_url         String?
  portfolio_url      String?
  bio                String?                    @db.Text
  skills             Json                       @default("[]")
  target_roles       Json                       @default("[]")
  years_of_experience Float?
  work_mode          String?
  current_ctc        Int?
  target_locations   Json                       @default("[]")
  expected_salary    Int?
  notice_period      String?
  work_authorization String?
  proud_project      String?                    @db.Text
  work_values        Json                       @default("[]")
  availability       Json                       @default("{}")
  // Candidate preferences (notifications, privacy, theme, AI voice, etc.)
  settings           Json                       @default("{}")
  resume_embedding   Unsupported("vector(768)")?
  created_at         DateTime                   @default(now())

  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  applications  Application[]
  mock_sessions MockSession[]
  talent_bookmarks TalentBookmark[]

  @@index([user_id])
}

model Application {
  id                    String            @id @default(uuid())
  candidate_id          String
  job_id                String
  status                ApplicationStatus @default(applied)
  hr_round_status       HrRoundStatus?
  hr_round_scheduled_at DateTime?
  hr_round_completed_at DateTime?
  applied_at            DateTime          @default(now())

  candidate          CandidateProfile   @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job                Job                @relation(fields: [job_id], references: [id], onDelete: Cascade)
  interview          Interview?
  evaluations        Evaluation[]
  assessments        Assessment[]
  coding_submissions CodingSubmission[]
  offer              Offer?

  @@unique([candidate_id, job_id])
  @@index([job_id])
  @@index([candidate_id])
  @@index([status])
}

model Evaluation {
  id              String              @id @default(uuid())
  application_id  String              @unique
  stage           String
  resume_score    Float?
  interview_score Float?
  aptitude_score  Float?
  coding_score    Float?
  composite_score Float?
  confidence      Float?
  bias_flag       Boolean             @default(false)
  bias_report     Json?
  decision        EvaluationDecision?
  reasoning       String?             @db.Text
  created_at      DateTime            @default(now())

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
}

model Interview {
  id                String          @id @default(uuid())
  application_id    String          @unique
  scheduled_at      DateTime?
  transcript        Json?
  audio_url         String?
  proctor_flags     Json?
  engagement_signal Json?
  sentiment_report  Json?
  video_consent     Boolean         @default(false)
  status            InterviewStatus @default(scheduled)
  created_at        DateTime        @default(now())

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
}

model Assessment {
  id                     String           @id @default(uuid())
  application_id         String?
  session_id             String?
  test_type              AssessmentType
  questions              Json
  responses              Json?
  score                  Float?
  category_breakdown     Json?
  status                 AssessmentStatus @default(pending)
  question_schema_version Int             @default(1)
  current_chunk_index    Int              @default(0)
  total_question_count   Int              @default(0)
  // Idempotency ledger for chunk submissions: { "<chunkIndex>": { clientRequestId, submittedAt } }
  chunk_submissions      Json?
  created_at             DateTime         @default(now())

  application    Application?             @relation(fields: [application_id], references: [id], onDelete: Cascade)
  mock_session   MockSession?             @relation(fields: [session_id], references: [id], onDelete: Cascade)
  chunks         GeneratedQuestionChunk[]
  snapshots      CodingProblemSnapshot[]

  @@index([application_id])
  @@index([session_id])
}

// ── Static question bank (DB-seeded, no LLM generation) ──────────────────

model AptitudeQuestion {
  id            String   @id @default(uuid())
  category      String   // "Quantitative Aptitude" | "Logical Reasoning" | "Verbal Ability" | "Data Interpretation"
  difficulty    String   @default("medium") // "easy" | "medium" | "hard"
  question      String   @db.Text
  options       Json     // String[4]
  correct_index Int      // 0–3, server-side only — never sent to client
  explanation   String?  @db.Text
  tags          Json     @default("[]") // String[]
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  @@index([category, difficulty, is_active])
  @@index([is_active])
}

model CodingProblem {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  description        String   @db.Text
  difficulty         String   @default("medium")
  category           String   @default("Data Structures") // e.g. "Arrays", "Strings", "Trees"
  tags               Json     @default("[]")              // String[]
  is_active          Boolean  @default(true)
  starter_code       Json     @default("{}") // Record<language, string>
  entry_point        String   @default("solution")
  param_schema       Json     @default("[]")
  return_type        String   @default("any")
  public_tests       Json     @default("[]")
  hidden_tests       Json     @default("[]")
  reference_solution Json?
  seed               String?
  checksum           String?
  version            Int      @default(1)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  submissions CodingSubmission[]

  @@index([slug])
  @@index([difficulty, is_active])
  @@index([is_active])
}

model CodingSubmission {
  id                String         @id @default(uuid())
  application_id    String?
  candidate_id      String?
  problem_id        String?
  problem_snapshot_id String?
  attempt_number    Int            @default(1)
  idempotency_key   String?        @unique
  language          String
  code              String         @db.Text
  test_results      Json           @default("[]")
  pass_rate         Float          @default(0)
  pass_rate_percent Float          @default(0)
  pass_rate_ratio   Float          @default(0)
  execution_time_ms Int?
  memory_mb         Float?
  memory_kb         Int?
  complexity_score  Float?
  status            String?        @default("created")
  complexity        String?
  ai_feedback       String?        @db.Text
  stdout_stderr     String?        @db.Text
  code_hash         String?
  runner_version    String?
  error_message     String?        @db.Text
  created_at        DateTime       @default(now())
  completed_at      DateTime?

  application Application?         @relation(fields: [application_id], references: [id], onDelete: Cascade)
  problem     CodingProblem?       @relation(fields: [problem_id], references: [id], onDelete: SetNull)
  snapshot    CodingProblemSnapshot? @relation(fields: [problem_snapshot_id], references: [id], onDelete: SetNull)

  @@index([application_id])
  @@index([candidate_id])
  @@index([problem_id])
  @@index([problem_snapshot_id])
  @@index([idempotency_key])
  @@index([status])
}

model GeneratedQuestionChunk {
  id              String   @id @default(uuid())
  assessment_id   String
  chunk_index     Int
  chunk_size      Int
  question_ids    Json     @default("[]")
  questions       Json
  prompt_version  String   @default("v1")
  generation_seed String?
  content_hash    String?
  created_at      DateTime @default(now())

  assessment Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, chunk_index])
  @@index([assessment_id])
}

model CodingProblemSnapshot {
  id                      String   @id @default(uuid())
  assessment_id           String?
  session_id              String
  problem_id              String?
  slug                    String?
  title                   String
  description             String   @db.Text
  difficulty              String   @default("medium")
  category                String?
  entry_point             String   @default("solution")
  parameter_schema        Json     @default("[]")
  return_type             String   @default("any")
  public_test_cases       Json     @default("[]")
  hidden_test_cases       Json     @default("[]")
  starter_code            Json     @default("{}")
  reference_solution_hash String?
  problem_version         Int      @default(1)
  content_hash            String?
  created_at              DateTime @default(now())

  mock_session MockSession        @relation(fields: [session_id], references: [id], onDelete: Cascade)
  assessment   Assessment?        @relation(fields: [assessment_id], references: [id], onDelete: SetNull)
  submissions  CodingSubmission[]

  @@unique([session_id])
  @@index([session_id])
  @@index([assessment_id])
}

model VideoSubmission {
  id               String    @id @default(uuid())
  session_id       String
  candidate_id     String
  prompt_id        String?
  prompt_index     Int       @default(0)
  video_url        String
  duration_seconds Int       @default(0)
  status           String    @default("queued")
  transcript       String?   @db.Text
  score            Float?
  feedback         Json?
  idempotency_key  String?   @unique
  created_at       DateTime  @default(now())
  completed_at     DateTime?

  mock_session MockSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([candidate_id])
  @@index([status])
}

model Offer {
  id                   String      @id @default(uuid())
  application_id       String      @unique
  role_title           String
  salary               Int
  equity               String?
  start_date           DateTime?
  status               OfferStatus @default(pending)
  signature_svg        String?     @db.Text
  offer_letter_content String?     @db.Text
  magic_link_token     String?
  valid_until          DateTime?
  created_at           DateTime    @default(now())

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
  @@index([magic_link_token])
}

model AgentLog {
  id         String      @id @default(uuid())
  job_id     String?
  org_id     String?
  agent_name String
  action     String
  input      Json?
  output     Json?
  status     AgentStatus @default(running)
  error      String?     @db.Text
  created_at DateTime    @default(now())

  job          Job?          @relation(fields: [job_id], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [org_id], references: [id], onDelete: SetNull)

  @@index([job_id])
  @@index([org_id])
  @@index([agent_name])
}

model MockSession {
  id               String    @id @default(uuid())
  candidate_id     String
  target_company   String
  target_role      String
  difficulty       String?
  type             String    @default("mock")
  // Mock interview lifecycle: created -> in_progress -> aptitude_in_progress ->
  // aptitude_completed -> coding_in_progress -> coding_completed ->
  // video_in_progress -> video_processing -> video_completed ->
  // feedback_processing -> completed (or abandoned from any active state).
  status           String    @default("created")
  current_section  String    @default("aptitude")
  generation_seed  String?
  started_at       DateTime?
  completed_at     DateTime?
  final_score      Float?
  final_feedback   Json?
  topic            String?
  focus_areas      Json?
  rubric           Json?
  video_prompts    Json?
  transcript       Json?
  score            Float?
  feedback         Json?
  generated_resume Json?
  resume_pdf_url   String?
  ended_at         DateTime?
  created_at       DateTime  @default(now())

  candidate         CandidateProfile      @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  assessments       Assessment[]
  coding_snapshots  CodingProblemSnapshot[]
  video_submissions VideoSubmission[]

  @@index([candidate_id])
  @@index([type])
  @@index([status])
}

model PrepContent {
  id              String   @id @default(uuid())
  company_name    String
  role_archetype  String
  job_id          String?
  org_id          String?
  questions       Json
  culture_notes   String?  @db.Text
  skill_checklist Json?
  updated_at      DateTime @updatedAt

  job          Job?          @relation(fields: [job_id], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [org_id], references: [id], onDelete: SetNull)

  @@unique([company_name, role_archetype])
  @@index([job_id])
  @@index([org_id])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String   @db.Text
  type       String   @default("info")
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([read])
}

model TalentBookmark {
  id           String   @id @default(uuid())
  org_id       String
  candidate_id String
  job_id       String?
  notes        String?  @db.Text
  created_at   DateTime @default(now())

  organization Organization     @relation(fields: [org_id], references: [id], onDelete: Cascade)
  candidate    CandidateProfile @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job          Job?             @relation(fields: [job_id], references: [id], onDelete: SetNull)

  @@unique([org_id, candidate_id])
  @@index([org_id])
  @@index([candidate_id])
  @@index([job_id])
}
