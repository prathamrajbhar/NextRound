generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
  previewFeatures     = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  hr
  candidate
}

enum JobStatus {
  draft
  published
  active
  paused
  closed
  deleted
}

enum ApplicationStatus {
  applied
  screening
  screening_completed
  assessment
  interview_scheduled
  interviewed
  evaluation
  hr_round
  decided
  offered
  accepted
  rejected
  withdrawn
}

enum HrRoundStatus {
  pending
  scheduled
  passed
  failed
}

enum EvaluationDecision {
  hire
  reject
  hold_for_review
}

enum InterviewStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum AssessmentType {
  aptitude
  coding
}

enum AssessmentStatus {
  pending
  in_progress
  completed
  expired
}

enum OfferStatus {
  pending
  accepted
  declined
  expired
}

enum AgentStatus {
  running
  completed
  failed
}

enum SocialSource {
  github
  linkedin
}

enum SocialSyncStatus {
  pending
  synced
  failed
  not_found
  removed
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password_hash      String
  role               UserRole
  org_id             String?
  reset_token_hash   String?
  reset_token_expiry DateTime?

  profile            Json      @default("{}")
  created_at         DateTime  @default(now())

  organization      Organization?     @relation(fields: [org_id], references: [id], onDelete: SetNull)
  candidate_profile CandidateProfile?
  notifications     Notification[]

  @@index([email])
  @@index([org_id])
  @@index([reset_token_hash])
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  logo_url   String?
  industry   String?
  size       String?
  settings   Json     @default("{}")
  created_at DateTime @default(now())

  users         User[]
  jobs          Job[]
  agent_logs    AgentLog[]
  prep_contents PrepContent[]
  talent_bookmarks TalentBookmark[]
}

model Job {
  id              String                    @id @default(uuid())
  org_id          String
  title           String
  description     String                    @db.Text
  rubric          Json                      @default("{}")
  thresholds      Json                      @default("{}")
  status          JobStatus                 @default(draft)
  location        String?
  salary          String?
  experienceLevel String?
  department      String?
  skills          Json?
  stages          Json?
  assessmentConfig Json?
  embedding       Unsupported("vector(768)")?
  created_at      DateTime                  @default(now())

  organization  Organization  @relation(fields: [org_id], references: [id], onDelete: Cascade)
  applications  Application[]
  agent_logs    AgentLog[]
  prep_contents PrepContent[]
  talent_bookmarks TalentBookmark[]

  @@index([org_id])
  @@index([status])
}

model CandidateProfile {
  id                 String                     @id @default(uuid())
  user_id            String                     @unique
  full_name          String?
  headline           String?
  phone              String?
  location           String?
  timezone           String?
  avatar_url         String?
  resume_url         String?
  raw_resume_text    String?                    @db.Text
  parsed_resume      Json                       @default("{}")
  social_data        Json                       @default("{}")
  linkedin_url       String?
  github_url         String?
  portfolio_url      String?
  bio                String?                    @db.Text
  skills             Json                       @default("[]")
  target_roles       Json                       @default("[]")
  years_of_experience Float?
  work_mode          String?
  current_ctc        Int?
  target_locations   Json                       @default("[]")
  expected_salary    Int?
  notice_period      String?
  work_authorization String?
  proud_project      String?                    @db.Text
  work_values        Json                       @default("[]")
  availability       Json                       @default("{}")

  settings           Json                       @default("{}")
  resume_embedding   Unsupported("vector(768)")?
  data_consent       Boolean                    @default(false)
  data_consent_at    DateTime?
  created_at         DateTime                   @default(now())

  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  applications  Application[]
  mock_sessions MockSession[]
  talent_bookmarks TalentBookmark[]
  proctoring_sessions ProctoringSession[]
  social_syncs  SocialProfileSync[]
  candidate_embeddings CandidateEmbedding[]

  @@index([user_id])
}

model SocialProfileSync {
  id              String          @id @default(uuid())
  candidate_id    String
  source          SocialSource
  username        String
  status          SocialSyncStatus @default(pending)
  raw_data        Json?
  normalized_data Json?
  error           String?         @db.Text
  synced_at       DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  candidate CandidateProfile @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@unique([candidate_id, source])
  @@index([candidate_id])
}

model CandidateEmbedding {
  id           String  @id @default(uuid())
  candidate_id String
  source_type  String
  section      String
  content      String  @db.Text
  embedding    Unsupported("vector(768)")
  content_hash String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  candidate CandidateProfile @relation(fields: [candidate_id], references: [id], onDelete: Cascade)

  @@unique([candidate_id, source_type, section])
  @@index([candidate_id])
}

model Application {
  id                    String            @id @default(uuid())
  candidate_id          String
  job_id                String
  status                ApplicationStatus @default(applied)
  hr_round_status       HrRoundStatus?
  hr_round_scheduled_at DateTime?
  hr_round_completed_at DateTime?
  applied_at            DateTime          @default(now())

  candidate          CandidateProfile   @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job                Job                @relation(fields: [job_id], references: [id], onDelete: Cascade)
  interview          Interview?
  evaluations        Evaluation[]
  assessments        Assessment[]
  coding_submissions CodingSubmission[]
  offer              Offer?
  proctoring_sessions ProctoringSession[]

  @@unique([candidate_id, job_id])
  @@index([job_id])
  @@index([candidate_id])
  @@index([status])
}

model Evaluation {
  id              String              @id @default(uuid())
  application_id  String              @unique
  stage           String
  resume_score    Float?
  interview_score Float?
  aptitude_score  Float?
  coding_score    Float?
  composite_score Float?
  confidence      Float?
  decision        EvaluationDecision?
  reasoning       String?             @db.Text
  created_at      DateTime            @default(now())

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
}

model Interview {
  id                String          @id @default(uuid())
  application_id    String          @unique
  scheduled_at      DateTime?
  transcript        Json?
  audio_url         String?
  proctor_flags     Json?
  engagement_signal Json?
  sentiment_report  Json? /// Audio-derived prosody/sentiment report (tone, pitch, speaking rate, pauses, stress, confidence) computed from audio_url. Never derived from transcript text.
  status            InterviewStatus @default(scheduled)
  created_at        DateTime        @default(now())

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
}

model Assessment {
  id                     String           @id @default(uuid())
  application_id         String?
  session_id             String?
  test_type              AssessmentType
  questions              Json
  responses              Json?
  score                  Float?
  category_breakdown     Json?
  status                 AssessmentStatus @default(pending)
  question_schema_version Int             @default(1)
  current_chunk_index    Int              @default(0)
  total_question_count   Int              @default(0)

  chunk_submissions      Json?
  created_at             DateTime         @default(now())

  application    Application?             @relation(fields: [application_id], references: [id], onDelete: Cascade)
  mock_session   MockSession?             @relation(fields: [session_id], references: [id], onDelete: Cascade)
  chunks         GeneratedQuestionChunk[]
  snapshots      CodingProblemSnapshot[]
  proctoring_sessions ProctoringSession[]

  @@index([application_id])
  @@index([session_id])
}

model AptitudeQuestion {
  id            String   @id @default(uuid())
  category      String
  difficulty    String   @default("medium")
  question      String   @db.Text
  options       Json
  correct_index Int
  explanation   String?  @db.Text
  tags          Json     @default("[]")
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  @@index([category, difficulty, is_active])
  @@index([is_active])
}

model CodingProblem {
  id                 String   @id @default(uuid())
  slug               String   @unique
  title              String
  description        String   @db.Text
  difficulty         String   @default("medium")
  category           String   @default("Data Structures")
  tags               Json     @default("[]")
  is_active          Boolean  @default(true)
  starter_code       Json     @default("{}")
  entry_point        String   @default("solution")
  param_schema       Json     @default("[]")
  return_type        String   @default("any")
  public_tests       Json     @default("[]")
  hidden_tests       Json     @default("[]")
  reference_solution Json?
  seed               String?
  checksum           String?
  version            Int      @default(1)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  submissions CodingSubmission[]

  @@index([slug])
  @@index([difficulty, is_active])
  @@index([is_active])
}

model CodingSubmission {
  id                String         @id @default(uuid())
  application_id    String?
  candidate_id      String?
  problem_id        String?
  problem_snapshot_id String?
  attempt_number    Int            @default(1)
  idempotency_key   String?        @unique
  language          String
  code              String         @db.Text
  test_results      Json           @default("[]")
  pass_rate         Float          @default(0)
  pass_rate_percent Float          @default(0)
  pass_rate_ratio   Float          @default(0)
  execution_time_ms Int?
  memory_mb         Float?
  memory_kb         Int?
  complexity_score  Float?
  status            String?        @default("created")
  complexity        String?
  ai_feedback       String?        @db.Text
  stdout_stderr     String?        @db.Text
  code_hash         String?
  runner_version    String?
  error_message     String?        @db.Text
  created_at        DateTime       @default(now())
  completed_at      DateTime?

  application Application?         @relation(fields: [application_id], references: [id], onDelete: Cascade)
  problem     CodingProblem?       @relation(fields: [problem_id], references: [id], onDelete: SetNull)
  snapshot    CodingProblemSnapshot? @relation(fields: [problem_snapshot_id], references: [id], onDelete: SetNull)

  @@index([application_id])
  @@index([candidate_id])
  @@index([problem_id])
  @@index([problem_snapshot_id])
  @@index([idempotency_key])
  @@index([status])
}

model GeneratedQuestionChunk {
  id              String   @id @default(uuid())
  assessment_id   String
  chunk_index     Int
  chunk_size      Int
  question_ids    Json     @default("[]")
  questions       Json
  prompt_version  String   @default("v1")
  generation_seed String?
  content_hash    String?
  created_at      DateTime @default(now())

  assessment Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)

  @@unique([assessment_id, chunk_index])
  @@index([assessment_id])
}

model CodingProblemSnapshot {
  id                      String   @id @default(uuid())
  assessment_id           String?
  session_id              String
  problem_id              String?
  slug                    String?
  title                   String
  description             String   @db.Text
  difficulty              String   @default("medium")
  category                String?
  entry_point             String   @default("solution")
  parameter_schema        Json     @default("[]")
  return_type             String   @default("any")
  public_test_cases       Json     @default("[]")
  hidden_test_cases       Json     @default("[]")
  starter_code            Json     @default("{}")
  reference_solution_hash String?
  problem_version         Int      @default(1)
  content_hash            String?
  created_at              DateTime @default(now())

  mock_session MockSession        @relation(fields: [session_id], references: [id], onDelete: Cascade)
  assessment   Assessment?        @relation(fields: [assessment_id], references: [id], onDelete: SetNull)
  submissions  CodingSubmission[]

  @@unique([session_id])
  @@index([session_id])
  @@index([assessment_id])
}

model Offer {
  id                   String      @id @default(uuid())
  application_id       String      @unique
  role_title           String
  salary               Int
  equity               String?
  start_date           DateTime?
  status               OfferStatus @default(pending)
  signature_svg        String?     @db.Text
  offer_letter_content String?     @db.Text
  magic_link_token     String?
  valid_until          DateTime?
  created_at           DateTime    @default(now())

  application Application @relation(fields: [application_id], references: [id], onDelete: Cascade)

  @@index([application_id])
  @@index([magic_link_token])
}

model AgentLog {
  id         String      @id @default(uuid())
  job_id     String?
  org_id     String?
  agent_name String
  action     String
  input      Json?
  output     Json?
  status     AgentStatus @default(running)
  error      String?     @db.Text
  created_at DateTime    @default(now())

  job          Job?          @relation(fields: [job_id], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [org_id], references: [id], onDelete: SetNull)

  @@index([job_id])
  @@index([org_id])
  @@index([agent_name])
}

model MockSession {
  id               String    @id @default(uuid())
  candidate_id     String
  target_company   String
  target_role      String
  difficulty       String?
  type             String    @default("mock")

  status           String    @default("created")
  current_section  String    @default("aptitude")
  generation_seed  String?
  started_at       DateTime?
  completed_at     DateTime?
  final_score      Float?
  final_feedback   Json?
  topic            String?
  focus_areas      Json?
  rubric           Json?
  transcript       Json?
  score            Float?
  feedback         Json?
  generated_resume Json?
  resume_pdf_url   String?
  ended_at         DateTime?
  created_at       DateTime  @default(now())

  candidate         CandidateProfile      @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  assessments       Assessment[]
  coding_snapshots  CodingProblemSnapshot[]
  proctoring_sessions ProctoringSession[]

  @@index([candidate_id])
  @@index([type])
  @@index([status])
}

model PrepContent {
  id              String   @id @default(uuid())
  company_name    String
  role_archetype  String
  job_id          String?
  org_id          String?
  questions       Json
  culture_notes   String?  @db.Text
  skill_checklist Json?
  updated_at      DateTime @updatedAt

  job          Job?          @relation(fields: [job_id], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [org_id], references: [id], onDelete: SetNull)

  @@unique([company_name, role_archetype])
  @@index([job_id])
  @@index([org_id])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String   @db.Text
  type       String   @default("info")
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([read])
}

model TalentBookmark {
  id           String   @id @default(uuid())
  org_id       String
  candidate_id String
  job_id       String?
  notes        String?  @db.Text
  created_at   DateTime @default(now())

  organization Organization     @relation(fields: [org_id], references: [id], onDelete: Cascade)
  candidate    CandidateProfile @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  job          Job?             @relation(fields: [job_id], references: [id], onDelete: SetNull)

  @@unique([org_id, candidate_id])
  @@index([org_id])
  @@index([candidate_id])
  @@index([job_id])
}

model ProctoringSession {
  id                String    @id @default(uuid())
  candidate_id      String
  assessment_id     String?
  application_id    String?
  mock_session_id   String?
  session_type      String
  status            String
  policy_version    String
  consent_version   String
  recording_url     String?
  recording_duration_ms Int?
  recording_size_bytes  Int?
  risk_score        Float?
  summary_json      Json          @default("{}")
  started_at        DateTime      @default(now())
  ended_at          DateTime?
  last_heartbeat_at DateTime?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  candidate      CandidateProfile     @relation(fields: [candidate_id], references: [id], onDelete: Cascade)
  assessment     Assessment?          @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  application    Application?         @relation(fields: [application_id], references: [id], onDelete: Cascade)
  mock_session   MockSession?         @relation(fields: [mock_session_id], references: [id], onDelete: Cascade)
  events         ProctoringEvent[]
  violations     ProctoringViolation[]
  evidence       ProctoringEvidence[]

  @@index([candidate_id])
  @@index([assessment_id])
  @@index([application_id])
  @@index([mock_session_id])
}

model ProctoringEvidence {
  id                    String            @id @default(uuid())
  proctoring_session_id String
  kind                  String
  mime_type             String
  url                   String
  size_bytes            Int?
  width                 Int?
  height                Int?
  captured_at           DateTime          @default(now())
  payload_json          Json              @default("{}")
  created_at            DateTime          @default(now())

  proctoring_session    ProctoringSession @relation(fields: [proctoring_session_id], references: [id], onDelete: Cascade)

  @@index([proctoring_session_id])
  @@index([kind])
}

model ProctoringEvent {
  id                    String            @id @default(uuid())
  proctoring_session_id String
  client_event_id       String
  client_sequence       Int
  server_sequence       Int
  kind                  String
  severity              String
  source                String
  client_timestamp      DateTime
  server_received_at    DateTime          @default(now())
  session_elapsed_ms    Int
  payload_json          Json              @default("{}")
  created_at            DateTime          @default(now())

  proctoring_session    ProctoringSession @relation(fields: [proctoring_session_id], references: [id], onDelete: Cascade)

  @@unique([proctoring_session_id, client_event_id])
  @@unique([proctoring_session_id, server_sequence])
  @@index([proctoring_session_id])
}

model ProctoringViolation {
  id                    String            @id @default(uuid())
  proctoring_session_id String
  rule_code             String
  severity              String
  occurrence_count      Int               @default(1)
  first_seen_at         DateTime
  last_seen_at          DateTime
  status                String            @default("pending_review")
  reviewer_id           String?
  review_reason         String?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  proctoring_session    ProctoringSession @relation(fields: [proctoring_session_id], references: [id], onDelete: Cascade)

  @@unique([proctoring_session_id, rule_code])
  @@index([proctoring_session_id])
}

model WebRTCSignal {
  id             String   @id @default(uuid())
  application_id String
  sender         String
  message        Json
  created_at     DateTime @default(now())

  @@index([application_id])
}
